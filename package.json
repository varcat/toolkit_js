{
  "name": "wsp-toolkit",
  "version": "0.6.3",
  "description": "Personal toolbox",
  "main": "dist/wsp-toolkit.cjs.prod.js",
  "unpkg": "dist/wsp-toolkit.global.prod.js",
  "jsdelivr": "dist/wsp-toolkit.global.prod.js",
  "module": "dist/wsp-toolkit.esm-bundler.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "rm": "node scripts/rm",
    "build": "tsup --config tsup.config.ts && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "jest",
    "pub": "npm publish --access public",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build --outDir docs --base /toolkit_js/",
    "docs:preview": "vitepress preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varcat/toolkit_js.git"
  },
  "keywords": [
    "toolkit",
    "utils"
  ],
