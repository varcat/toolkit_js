  "bugs": {
    "url": "https://github.com/varcat/toolkit_js/issues"
  },
  "homepage": "https://github.com/varcat/toolkit_js#readme",
  "devDependencies": {
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.4.5",
    "tsup": "^8.0.1",
    "typescript": "^5.7.3",
    "vitepress": "^1.4.3"
  }
}
